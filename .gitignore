# ───────────────────────── Morning Scanner .gitignore ─────────────────────────

# Virtual environments
.venv/
venv/
venv_rollback/
venv_titan/

# Python build artifacts
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/

# Runtime state & caches — regenerated by the app on launch
scanner_settings.json
wires_cache.json
sec_tickers.json
*.parquet

# Internal development docs & legacy code (kept locally, not published)
AUDIT_*.md
HARDENING_*.md
CHANGELOG*.md
README_OLD.md
readme2.md
old/

# Local / alternate build specs + icons not shipped in this repo (kept locally).
# MS_ZACKS.spec is the maintainer's private working build; the public build
# spec is TNS.spec (produces TNS.exe).
MS_ZACKS.spec
Scanner_Universal.spec
Universal_SG.spec
icon2.ico
titan.ico

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
